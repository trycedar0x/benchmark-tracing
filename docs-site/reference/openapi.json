{
  "components": {
    "schemas": {
      "AddItemsRequest": {
        "properties": {
          "outcomes": {
            "items": {
              "type": "string"
            },
            "title": "Outcomes",
            "type": "array"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "split": {
            "default": "unassigned",
            "title": "Split",
            "type": "string"
          },
          "trace_ids": {
            "items": {
              "type": "string"
            },
            "title": "Trace Ids",
            "type": "array"
          }
        },
        "title": "AddItemsRequest",
        "type": "object"
      },
      "DatasetRequest": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DatasetRequest",
        "type": "object"
      },
      "EvaluationSubmission": {
        "additionalProperties": false,
        "properties": {
          "allow_paid": {
            "title": "Allow Paid",
            "type": "boolean"
          },
          "benchmark": {
            "title": "Benchmark",
            "type": "string"
          },
          "content_policy": {
            "default": "redacted",
            "enum": [
              "metadata",
              "redacted",
              "full"
            ],
            "title": "Content Policy",
            "type": "string"
          },
          "extractor_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extractor Model"
          },
          "grading_timeout": {
            "default": 180,
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Grading Timeout",
            "type": "number"
          },
          "judge_models": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Judge Models",
            "type": "array"
          },
          "limit": {
            "anyOf": [
              {
                "maximum": 3350.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "sample_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 3350,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Ids"
          },
          "target_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          },
          "timeout": {
            "default": 40,
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Timeout",
            "type": "number"
          },
          "trace_timeout": {
            "default": 10,
            "maximum": 3600.0,
            "minimum": 0.0,
            "title": "Trace Timeout",
            "type": "number"
          }
        },
        "required": [
          "benchmark",
          "target_id",
          "judge_models",
          "allow_paid"
        ],
        "title": "EvaluationSubmission",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImportRequest": {
        "properties": {
          "content_policy": {
            "default": "redacted",
            "title": "Content Policy",
            "type": "string"
          },
          "max_traces": {
            "default": 100,
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Traces",
            "type": "integer"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "usage_rights": {
            "title": "Usage Rights",
            "type": "string"
          }
        },
        "required": [
          "source",
          "usage_rights"
        ],
        "title": "ImportRequest",
        "type": "object"
      },
      "KeyRequest": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "role": {
            "default": "member",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "KeyRequest",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "reference_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Output"
          },
          "split": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Split"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "usage_rights": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usage Rights"
          }
        },
        "title": "ReviewRequest",
        "type": "object"
      },
      "SealRequest": {
        "properties": {
          "expected_spans": {
            "minimum": 0.0,
            "title": "Expected Spans",
            "type": "integer"
          }
        },
        "required": [
          "expected_spans"
        ],
        "title": "SealRequest",
        "type": "object"
      },
      "SecretRequest": {
        "properties": {
          "value": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "SecretRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
