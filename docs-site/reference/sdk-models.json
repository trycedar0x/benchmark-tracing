{
  "$defs": {
    "AgentInput": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "parent_span_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Parent Span Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "input",
        "run_id",
        "sample_id",
        "trace_id",
        "parent_span_id"
      ],
      "title": "AgentInput",
      "type": "object"
    },
    "AgentResult": {
      "properties": {
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "usage": {
          "additionalProperties": true,
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "answer"
      ],
      "title": "AgentResult",
      "type": "object"
    },
    "BenchmarkCase": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input": {
          "title": "Input",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "reference": {
          "additionalProperties": true,
          "title": "Reference",
          "type": "object"
        }
      },
      "required": [
        "id",
        "input"
      ],
      "title": "BenchmarkCase",
      "type": "object"
    },
    "CaseResult": {
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "components": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Components",
          "type": "object"
        },
        "duration_seconds": {
          "default": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "enum": [
            "scored",
            "agent_error",
            "trace_missing",
            "grading_error",
            "cancelled",
            "timeout",
            "unscored"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "trace_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace State"
        }
      },
      "required": [
        "sample_id",
        "attempt",
        "status"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "EvaluationReport": {
      "properties": {
        "benchmark": {
          "title": "Benchmark",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/CaseResult"
          },
          "title": "Results",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "everybench.agent-evaluation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "target": {
          "additionalProperties": true,
          "title": "Target",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "benchmark",
        "target",
        "status",
        "results"
      ],
      "title": "EvaluationReport",
      "type": "object"
    },
    "GradeResult": {
      "properties": {
        "components": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Components",
          "type": "object"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "protocol"
      ],
      "title": "GradeResult",
      "type": "object"
    },
    "TraceEvent": {
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "status": {
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "TraceEvidence": {
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/TraceEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Id"
        },
        "source": {
          "default": "unknown",
          "title": "Source",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "complete",
            "incomplete",
            "missing",
            "withheld"
          ],
          "title": "State",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "state"
      ],
      "title": "TraceEvidence",
      "type": "object"
    }
  },
  "title": "EveryBench SDK models"
}
